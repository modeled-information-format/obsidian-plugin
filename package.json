{
  "name": "obsidian-mif",
  "version": "0.0.1",
  "private": true,
  "description": "Author, validate, and sync MIF (Modeled Information Format) bundles in Obsidian.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "python3 scripts/gen_golden.py",
    "sync-schemas": "node scripts/sync-schemas.mjs",
    "install-vault": "node scripts/install-vault.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
