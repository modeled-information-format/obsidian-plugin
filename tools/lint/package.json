{
  "name": "obsidian-mif-lint",
  "private": true,
  "description": "ESLint for the plugin, isolated: typescript-eslint needs TypeScript's JS API, which TypeScript 7 (used to build the plugin) does not have.",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "moment": "2.31.0",
    "fast-uri": "3.1.9",
    "eslint-plugin-n": {
      "minimatch": "11.0.1"
    },
    "eslint-plugin-json-schema-validator": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
